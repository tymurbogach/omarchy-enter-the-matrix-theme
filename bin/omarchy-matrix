#!/bin/bash

# The switchboard. Each piece turns on and off on its own.
#
#   <cli> on | off
#   <cli> wallpaper|screensaver|lock|boot|widget on|off|toggle
#   <cli> status [--is <piece>] [--json]
#   <cli> doctor
#   <cli> update [--check [--json]]
#
# Which pack this is comes from provider.json, below: everything in here is
# machinery, and the provider contributes the shader, its assets and its names.
#
# Settings live in ~/.config/omarchy/<slug>.json, a file of our own. They are
# deliberately NOT in shell.json: `omarchy refresh shell` rewrites that file
# wholesale and would take them with it.

set -euo pipefail

SELF=$(basename "$0")

fail() {
  echo "$SELF: $*" >&2
  exit 1
}

# --- the provider -----------------------------------------------------------
# The pack is machinery plus one provider, and provider.json is the only file
# that names the provider. lib/provider.py resolves it the same way for the two
# derivers: keep the two in step.
#
# The CLI finds its own root by resolving itself: installed, it is a symlink
# into the share dir's bin/, and in a working copy it sits in the repo's bin/.
# Either way the root beside bin/ holds provider.json and lib/. The share dir
# outlives theme switches, which is exactly when `suspend` and `lock off` run.
# An explicit $OMARCHY_MATRIX_PROVIDER still wins, and is what tests use.
ROOT=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
for candidate in \
  "${OMARCHY_MATRIX_PROVIDER:-}" \
  "$ROOT/provider.json"; do
  [[ -n $candidate && -f $candidate ]] || continue
  PROVIDER="$candidate"
  break
done
[[ -n ${PROVIDER:-} ]] || fail "cannot find provider.json. Re-run the pack's install.sh."

# Shared shell: provider names, paths, ownership, plugin list, settle, restart.
# shellcheck source=../lib/pack.sh
. "$ROOT/lib/pack.sh" || fail "cannot load $ROOT/lib/pack.sh"
pack_load_provider "$PROVIDER" || fail "$PROVIDER is not valid JSON"
pack_set_paths

PIECES=(wallpaper screensaver lock boot widget)

# --- state ------------------------------------------------------------------

# The desktop pieces are only IN EFFECT while the pack's theme is the current
# one:
# picking another theme makes the theme-set hook call `suspend`, which stands
# them down without touching the settings. Without this, `status` used to tick
# four pieces that were in fact off, and the pack looked broken.
#
# `boot` is the exception: the Plymouth splash belongs to the system, not to
# the theme, and stays put whichever theme you pick.
current_theme() {
  cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null
}

pack_in_effect() {
  [[ $(current_theme) == "$SLUG" ]]
}

# `boot` does not follow the theme, so its tick asks the system instead: is our
# Plymouth theme the one actually in use? That way the ✓ never lies, even though
# it stays on when you switch to another theme.
#
# Not `omarchy plymouth current`: that one identifies the theme by comparing
# logo.png inside Omarchy's OWN theme folder, and ours is a separate theme it
# cannot see. `plymouth-set-default-theme` with no arguments prints the real
# answer and needs no sudo.
boot_applied() {
  local current
  current=$(plymouth-set-default-theme 2>/dev/null) ||
    current=$(sed -n 's/^Theme=//p' /etc/plymouth/plymouthd.conf 2>/dev/null)
  [[ $current == "$PLYMOUTH_THEME" ]]
}

# Switched on in the settings AND in effect right now. This is what the widget
# and `status` ask, so it is what decides the ✓.
#
# The tick is supposed to mean "this is happening now", and for `wallpaper` it
# used to mean "configured". Observed after a round trip to another theme and
# back: `✓ wallpaper` printed with ZERO rain surfaces on screen, because
# `omarchy theme set` rotates to the theme's next background and the rotation
# had landed on a still. Being on the live background is part of the piece being
# on, so it is part of the question.
#
# `boot` asks the system instead of the theme: the Plymouth splash belongs to
# the machine and stays put whichever theme you pick.
is_active() {
  [[ $(read_setting "$1") == "true" ]] || return 1
  [[ $1 == "boot" ]] || pack_in_effect || return 1
  case "$1" in
  boot) boot_applied ;;
  wallpaper) on_live_background && plugin_enabled "$PLUGIN_ID" ;;
  screensaver) plugin_enabled "$PLUGIN_ID" && screensaver_flag_set ;;
  lock) lock_clone_enabled ;;
  widget) plugin_enabled "$WIDGET_ID" ;;
  esac
}

active_of() {
  is_active "$1" && echo true || echo false
}

read_setting() {
  local piece="$1"
  [[ -f $CONFIG ]] || { echo "true"; return; }
  # `// true` is wrong here: jq treats false as absent, so `boot: false` would
  # come back as true. Ask for the key, not for its value.
  jq -r --arg k "$piece" 'if has($k) then .[$k] else true end | tostring' "$CONFIG" 2>/dev/null || echo "true"
}

write_setting() {
  write_key "$1" --argjson "$2"
}

# `previousTheme` is a string, not a switch. Same file: it is the pack's own,
# and it is the only place that survives both a theme change and an uninstall
# that has not happened yet.
write_string() {
  write_key "$1" --arg "$2"
}

write_key() {
  local key="$1" kind="$2" value="$3" tmp
  mkdir -p "$(dirname "$CONFIG")"
  [[ -f $CONFIG ]] || echo '{}' >"$CONFIG"
  tmp=$(mktemp "$CONFIG.XXXXXX")
  jq --arg k "$key" "$kind" v "$value" '.[$k] = $v' "$CONFIG" >"$tmp" 2>/dev/null ||
    { rm -f "$tmp"; fail "could not write $CONFIG"; }
  mv "$tmp" "$CONFIG"
}

# `omarchy plugin clone` decides the lock clone's id: <username>.lock. Discover
# it rather than assume it, because on another machine the username differs.
# Whether a folder is ours is lock_is_ours in lib/pack.sh: the one rule shared
# with uninstall.sh and derive-lock.py.
lock_clone_id() {
  local dir
  for dir in "$PLUGINS_DIR"/*.lock; do
    lock_is_ours "$dir" || continue
    jq -r '.id' "$dir/manifest.json"
    return 0
  done
  return 1
}

# The pack's only footprint outside $HOME. `omarchy plymouth reset` puts
# Omarchy's theme back but leaves ours sitting in /usr/share/plymouth/themes, so
# off has to take it back too -- someone who never runs uninstall.sh would carry
# it forever otherwise (Rule 5: off must mean gone).
#
# Always AFTER the reset, never before: pulling the directory out from under a
# theme that is still the default is how a machine boots to a black screen.
remove_plymouth_theme() {
  local dir="/usr/share/plymouth/themes/$PLYMOUTH_THEME"
  [[ -d $dir ]] || return 0
  sudo rm -rf "$dir"
}

# A lock is ours AND actually in charge. Merely having the clone on disk is not
# it: `omarchy refresh shell` rewrites shell.json wholesale and leaves the folder
# sitting there with Omarchy's own lock enabled again.
lock_clone_enabled() {
  local id
  id=$(lock_clone_id) || return 1
  plugin_enabled "$id"
}

screensaver_flag_set() {
  [[ -f "$HOME/.local/state/omarchy/toggles/screensaver-off" ]]
}

nudge_shell() {
  omarchy-shell "$IPC" refresh >/dev/null 2>&1 || true
}

# --- the theme directory ----------------------------------------------------
#
# `omarchy theme update` is a bare `git pull` per theme and fires NO hooks --
# not one, and `omarchy update` never calls it. So after a pull the theme moves
# on while the pack's copies of the plugin, the CLI, the derivers and the hooks
# sit at whatever version installed them. Nothing else would ever notice.
#
# So the CLI notices, on the one run that is meant to assert everything again:
# `doctor`, which the theme-set hook calls on every `omarchy theme set <slug>`.

theme_dir() {
  omarchy-theme-dir "$SLUG" 2>/dev/null
}

# Every file install.sh copies out of the theme directory, paired with where it
# lands. Kept here rather than derived from install.sh because a comparison that
# silently checks nothing is worse than no comparison at all.
installed_pairs() {
  local theme="$1" f
  for f in $(jq -r '.plugin.files[]' "$PROVIDER"); do
    echo "$theme/$PLUGIN_SRC/$f|$PLUGINS_DIR/$PLUGIN_ID/$f"
  done
  # The widget is deliberately ABSENT from this list, unlike .plugin.files[]
  # above. The rain plugin's sources still live in the theme directory, so a
  # `git pull` on the theme is exactly the event this comparison is for. The
  # widget's do not: it is fetched from its own repo into the share dir's
  # widget-src, so there is nothing under the theme directory to compare it
  # against. install.sh refreshes that clone on every run, including the --sync
  # this function ends up calling.
  echo "$theme/bin/$CLI|$SHARE_DIR/bin/$CLI"
  echo "$theme/lib/derive-lock.py|$SHARE_DIR/lib/derive-lock.py"
  echo "$theme/lib/derive-plymouth.py|$SHARE_DIR/lib/derive-plymouth.py"
  echo "$theme/lib/provider.py|$SHARE_DIR/lib/provider.py"
  echo "$theme/lib/pack.sh|$SHARE_DIR/lib/pack.sh"
  echo "$theme/uninstall.sh|$SHARE_DIR/uninstall.sh"
  # The hooks are deliberately ABSENT too: install.sh generates their wrappers
  # on every run (including the --sync this function ends up calling), so there
  # is no theme source to compare and nothing to go stale.
  echo "$theme/provider.json|$SHARE_DIR/provider.json"
}

# NEWER, not merely different. "Different" is the wrong question and it bit on
# the first run: a working copy installed over an older theme directory looks
# exactly as different as a pulled theme looks over an older install, and
# syncing then copies the OLD files over the new ones. A `git pull` gives every
# file it changes a fresh mtime, which is precisely the event this is for.
#
# A source file that is missing is not staleness either, it is a theme directory
# that does not carry that file -- an older or a newer layout.
files_outdated() {
  local theme="$1" source target top
  while IFS='|' read -r source target; do
    [[ -f $source ]] || continue
    # A plugin folder carrying a .git checkout is managed by hand, and
    # install.sh leaves it alone for the same reason: judging it stale here
    # would send --sync after a checkout nothing may overwrite.
    case "$target" in
    "$PLUGINS_DIR"/*)
      top="${target#"$PLUGINS_DIR"/}"; top="${top%%/*}"
      [[ -e $PLUGINS_DIR/$top/.git ]] && continue
      ;;
    esac
    [[ -f $target && ! $source -nt $target ]] || return 0
  done < <(installed_pairs "$theme")
  return 1
}

sync_files() {
  local theme
  theme=$(theme_dir) || return 0
  [[ -n $theme && -x $theme/install.sh ]] || return 0
  files_outdated "$theme" || return 0
  echo "  the theme directory has moved on; refreshing the pack's copies"
  "$theme/install.sh" --sync || echo "  could not refresh them; run $theme/install.sh" >&2
}

# --- updates ----------------------------------------------------------------
#
# The theme updates from its own repository and from nowhere else, and only
# when you ask: `update --check` looks, `update` pulls.
#
# The URL is written out in the two git commands below, not read from
# provider.json like every other name in this file. The marketplace's security
# baseline accepts a pull whose result later runs only when the command itself
# names the submission's own repository (commandUsesOnlySubmissionRepository in
# its scripts/security-baseline-analysis.mjs). Behind a variable it sees no URL
# and reports unpinned remote code. tools/check.sh keeps both URLs equal to
# provider.json's repoUrl.
#
# `omarchy theme update` is not used: it pulls every git theme you have, not
# only this one.

UPDATE_CACHE="$HOME/.cache/$CLI/update.json"
UPDATE_MAX_AGE=21600 # six hours: an open panel must not ask GitHub every time

# The version of the theme folder. doctor syncs the pack to it on the next
# `omarchy theme set`, so this is the version you run.
pack_version() {
  local dir
  dir=$(theme_dir) || return 0
  jq -r '.version // ""' "$dir/manifest.json" 2>/dev/null || true
}

update_document() { # <current> <latest> <available>
  jq -nc --argjson schema 1 --arg current "$1" --arg latest "$2" --argjson available "$3" \
    '{schema: $schema, current: $current, latest: $latest, available: $available}'
}

# Never fails. No network, a theme folder that is not a git clone, or a clone
# with commits of its own all mean "no update to offer": a clone that has moved
# on by itself is somebody's working copy, and pulling into it is their call.
cmd_update_check() {
  local json=0 dir head="" current latest="" available=false looked=0 now document
  [[ ${1:-} == --json ]] && json=1
  dir=$(theme_dir) || dir=""
  current=$(pack_version)
  if [[ -n $dir && -e $dir/.git ]]; then
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || head=""
  fi
  now=$(date +%s)
  # An answer about the same commit, younger than six hours, is still true.
  if [[ -n $head ]] && jq -e --arg head "$head" --argjson now "$now" --argjson max "$UPDATE_MAX_AGE" \
    '.head == $head and ($now - .checked) < $max' "$UPDATE_CACHE" >/dev/null 2>&1; then
    document=$(jq -c '{schema, current, latest, available}' "$UPDATE_CACHE")
    looked=1
  elif [[ -n $head ]] &&
    timeout 15 git -C "$dir" fetch --quiet https://github.com/tymurbogach/omarchy-enter-the-matrix-theme master 2>/dev/null; then
    if ! git -C "$dir" merge-base --is-ancestor FETCH_HEAD HEAD 2>/dev/null &&
      git -C "$dir" merge-base --is-ancestor HEAD FETCH_HEAD 2>/dev/null; then
      available=true
      latest=$(git -C "$dir" show FETCH_HEAD:manifest.json 2>/dev/null | jq -r '.version // ""') || latest=""
    fi
    document=$(update_document "$current" "$latest" "$available")
    mkdir -p "${UPDATE_CACHE%/*}"
    jq -c --arg head "$head" --argjson checked "$now" '. + {head: $head, checked: $checked}' \
      <<<"$document" >"$UPDATE_CACHE.tmp" && mv "$UPDATE_CACHE.tmp" "$UPDATE_CACHE"
    looked=1
  else
    document=$(update_document "$current" "" false)
  fi

  if ((json)); then
    echo "$document"
  elif ((!looked)); then
    echo "$DISPLAY_NAME ${current:-?}: could not check for updates (no network, or the theme folder is not a git clone)"
  elif [[ $(jq -r .available <<<"$document") == true ]]; then
    echo "$DISPLAY_NAME $(jq -r .latest <<<"$document") is out, and you have ${current:-an older version}. Update with: $SELF update"
  else
    echo "$DISPLAY_NAME ${current:-?} is the latest version"
  fi
}

cmd_update() {
  case "${1:-}" in
  --check) shift; cmd_update_check "$@"; return ;;
  "") ;;
  *) fail "unknown option: $1 (use: update, or update --check [--json])" ;;
  esac
  local dir
  dir=$(theme_dir) || dir=""
  [[ -n $dir && -e $dir/.git ]] ||
    fail "the theme folder ${dir:-for $SLUG} is not a git clone, so it cannot update itself. Install it again with: omarchy theme install $(jq -r .repoUrl "$PROVIDER")"
  echo "Updating $DISPLAY_NAME in $dir"
  git -C "$dir" pull --ff-only https://github.com/tymurbogach/omarchy-enter-the-matrix-theme master ||
    fail "the pull stopped. If you changed files in $dir, commit or discard them, then run this again."
  rm -f "$UPDATE_CACHE"
  # The pulled theme's own CLI runs doctor: a new doctor applies a new layout,
  # and nothing overwrites this script while bash is still reading it.
  exec "$dir/bin/$CLI" doctor
}

# --- pieces -----------------------------------------------------------------

# The plugin is needed if either of its two layers is on.
sync_plugin() {
  local wanted="false"
  [[ $(read_setting wallpaper) == "true" || $(read_setting screensaver) == "true" ]] && wanted="true"

  if ! plugin_known "$PLUGIN_ID"; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    sleep 0.3
  fi
  plugin_known "$PLUGIN_ID" || {
    echo "$SELF: the $PLUGIN_ID plugin is not installed" >&2
    # NOT `omarchy plugin add <repo-url>`: that would install the whole repo as
    # the plugin, bypassing the CLI, the hooks and the menu. install.sh copies in
    # the five files the plugin actually needs. It is the only supported path.
    echo "  install it with: $(omarchy-theme-dir "$SLUG" 2>/dev/null || echo "$HOME/.config/omarchy/themes/$SLUG")/install.sh" >&2
    return 1
  }

  if [[ $wanted == "true" ]]; then
    plugin_enabled "$PLUGIN_ID" || { omarchy-plugin-enable "$PLUGIN_ID" >/dev/null; forget_plugin_list; }
  else
    ! plugin_enabled "$PLUGIN_ID" || { omarchy-plugin-disable "$PLUGIN_ID" >/dev/null; forget_plugin_list; }
  fi
}

# The desktop rain is picked like any other background in the carousel, so
# switching the piece on without selecting that background would show nothing:
# a ✓ in the menu and an unchanged screen. Switching it on selects it; switching
# it off moves away from it, because sitting on the still frame looks exactly
# like rain that has frozen.
#
# Careful with `omarchy theme set`: it rotates to the NEXT background of the
# theme, so re-applying the theme takes you off the live background. That
# theme-set hook does not force it -- that would be fighting Omarchy -- and this
# switch does it instead.
# The live background is whichever file carries "-live-" in its name, never a
# fixed number: sort order decides the theme's default and gets reshuffled.
#
# It used to be a screenshot of the shader, which was a poor thing to hand
# someone who installed the theme alone -- a frozen frame of the one thing that
# is supposed to move. Now a real still from the film does all three jobs:
# thumbnail in the picker, the marker that turns the rain on, and the frame you
# are left looking at if the plugin is off.
BACKGROUNDS="$HOME/.local/state/omarchy/current/theme/backgrounds"

live_background() {
  local f
  for f in "$BACKGROUNDS"/*-live-*; do
    [[ -f $f ]] || continue
    echo "$f"
    return 0
  done
  return 1
}

on_live_background() {
  [[ $(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null) == *-live-* ]]
}

select_live_background() {
  local live
  live=$(live_background) || return 0
  on_live_background || omarchy-theme-bg-set "$live" >/dev/null
}

apply_wallpaper() {
  if [[ $(read_setting wallpaper) == "true" ]]; then
    select_live_background
  elif on_live_background; then
    omarchy-theme-bg-next >/dev/null
  fi
  sync_plugin && nudge_shell
}

# With the flag set, omarchy-launch-screensaver bows out instead of opening the
# terminal with ttfx: the screensaver is drawn by our plugin, which is the same
# shader as the wallpaper and the lock.
sync_screensaver() {
  if [[ $(read_setting screensaver) == "true" ]]; then
    omarchy-toggle screensaver-off on
  else
    omarchy-toggle screensaver-off off
  fi
}

apply_screensaver() {
  sync_screensaver
  sync_plugin && nudge_shell
}

# Swapping the lock plugin has a window -- a second or two -- in which neither
# handler answers. The journal shows why: while both are momentarily loaded,
# Quickshell rejects one with "another handler is registered for target lock",
# and until the survivor finishes registering, `omarchy-shell lock status` says
# "Target not found.".
#
# Nothing has ever locked inside that window here. But Rule 4 is "never leave
# the machine unable to lock", and "it self-heals in about a second" is not the
# same statement. So wait for the target to come back, and if it does not, say
# what to do about it rather than returning success.
# Which plugins currently provide a lock. Compared before and after a swap:
# when this set changes, two lock plugins were briefly loaded at once and the
# shell has to be restarted. See restart_shell_for_lock.
enabled_locks() {
  forget_plugin_list
  plugin_list |
    jq -r '[.[] | select(.enabled and (.id | endswith(".lock"))) | .id] | sort | join(",")'
}

# A plugin rescan that is still in flight when the shell is told to go down
# SEGFAULTS quickshell. The scan finishes mid-teardown, builds the plugin
# services, and their IpcHandler asks the engine generation for the IPC registry
# that the teardown has already destroyed:
#
#   __dynamic_cast (src_type=EngineGenerationExt, dst_type=IpcHandlerRegistry)
#   IpcHandler::updateRegistration   ipchandler.cpp:318
#   IpcHandler::onPostReload         ipchandler.cpp:278
#   QQmlObjectCreator::finalize      <- shell.qml:300, comp.createObject()
#   Process::onFinished              <- the plugin scanner exiting
#
# Read out of a core dump on 2026-08-30. It is quickshell's bug, open upstream
# and not fixable from here -- quickshell-mirror/quickshell#972, same two lines.
# Ours is the workload that walks into it: `suspend` disables two plugins,
# removes the lock clone, prunes its backup and restarts the shell, all inside
# one second. Fifteen coredumps in three days, every one of them a `theme set`
# away from matrix. The settle itself lives in lib/pack.sh, shared with
# uninstall.sh, which removes the same folders.

# Swapping which plugin owns the lock leaves BOTH loaded in the running shell.
# Quickshell then hands the `lock` IPC target to one of them and refuses the
# other:
#
#   QML IpcHandler ... Handler was registered but will not be used because
#   another handler is registered for target lock
#
# Which one wins is not ours to choose, and here it alternated from run to run.
# When Omarchy's won, the machine locked to Omarchy's blurred wallpaper -- while
# `plugin list` reported cyberdyne.lock enabled, `lock status` answered, and the
# patched QML sat on disk exactly right. Every check the pack had passed. Only a
# screenshot of `omarchy-shell lock preview` showed the truth.
#
# `rescanPlugins` does not unload the loser; a restart does. This is the trap
# already written down in CONTRIBUTING.md, reaching the one piece where being wrong is
# invisible until you lock the screen.
restart_shell_for_lock() {
  echo "  restarting the shell so only one lock plugin is loaded"
  restart_shell || return 1
}

# Waits for a STEADY answer, not for the first one. Measured here: `lock off`
# returns after ~0.8s, while the handler on its way out is still registered and
# still replying; the real gap does not open until ~1.3s and lasts ~0.6s. A
# guard that stops at the first success is answered by the plugin that is
# leaving, and reports everything fine a second before nothing answers at all.
#
# So: 1.8s of uninterrupted replies, and any silence resets the count.
wait_for_lock() {
  local steady=0 waited=0
  while ((waited < 100)); do # 15s ceiling
    if omarchy-shell lock status 2>/dev/null | jq -e '.passwordPam' >/dev/null 2>&1; then
      steady=$((steady + 1))
      ((steady < 12)) || return 0
    else
      steady=0
    fi
    sleep 0.15
    waited=$((waited + 1))
  done
  echo "$SELF: the lock is not answering steadily after the swap." >&2
  echo "  Run 'omarchy restart shell' before locking the screen." >&2
  return 1
}

# Handing Omarchy's lock back ALWAYS goes through `plugin remove`, which is what
# re-enables it (cloneSourceRestores). Merely disabling the clone would leave
# the session with no lock enabled at all, because cloning put Omarchy's own
# into disabledPlugins: the machine could not lock.
remove_lock_clone() {
  local id
  id=$(lock_clone_id) || return 0
  remove_plugin "$id"
  prune_backups
}

apply_lock() {
  local before after
  before=$(enabled_locks)

  if [[ $(read_setting lock) == "true" ]]; then
    # The deriver resolves provider.json on its own, and could find a different
    # one than this CLI did (a working copy beside an install). Hand it ours.
    OMARCHY_MATRIX_PROVIDER="$PROVIDER" "$ROOT/lib/derive-lock.py" || return 1
  else
    if lock_clone_id >/dev/null; then
      remove_lock_clone
      echo "Handed the lock back to Omarchy"
    else
      return 0 # nothing was swapped, nothing to wait for
    fi
  fi

  # Only when the set actually changed. Re-deriving over a clone that was
  # already the enabled one -- what the theme-set hook does on every `omarchy
  # theme set <slug>` -- loads no second plugin and needs no restart.
  after=$(enabled_locks)
  [[ $before == "$after" ]] || restart_shell_for_lock
  wait_for_lock
}

# The bar icon and its panel: the pack's own switchboard, one click away.
#
# For a plugin of kind `bar-widget`, "enabled" means "present in bar.layout" --
# PluginRegistry.setEnabled inserts the entry there and removes it again
# (PluginRegistry.qml:498-520). That is why the widget is a plugin of its own
# and not another kind on the rain: turning both rain layers off disables that
# plugin, and folding the two together would take the icon off the bar with them.
apply_widget() {
  if [[ $(read_setting widget) == "true" ]]; then
    if ! plugin_known "$WIDGET_ID"; then
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
      sleep 0.3
    fi
    plugin_known "$WIDGET_ID" || {
      echo "$SELF: the $WIDGET_ID plugin is not installed" >&2
      return 1
    }
    plugin_enabled "$WIDGET_ID" ||
      { omarchy-plugin-enable "$WIDGET_ID" --section "$WIDGET_SECTION" >/dev/null; forget_plugin_list; }
  else
    ! plugin_enabled "$WIDGET_ID" || { omarchy-plugin-disable "$WIDGET_ID" >/dev/null; forget_plugin_list; }
  fi
}

apply_boot() {
  # The screen before login. Needs sudo and rebuilds the initramfs, so it never
  # happens on its own: only when you ask for it.
  #
  # `omarchy plymouth set-by-theme` will not do: it only takes colours and a
  # still PNG, and here the line is typed out. derive-plymouth.py starts from
  # this machine's omarchy.script and adds the animation, leaving Omarchy's own
  # theme untouched in its folder. Going back is `omarchy plymouth reset`.
  if [[ $(read_setting boot) == "true" ]]; then
    OMARCHY_MATRIX_PROVIDER="$PROVIDER" "$ROOT/lib/derive-plymouth.py" || return 1
  else
    # Only reset when OUR theme is the one installed. Resetting unconditionally
    # rebuilt the initramfs for nothing, and worse, it dragged somebody who had
    # picked `spinner` back to Omarchy's -- overriding a choice the pack never
    # made. The directory goes either way.
    if boot_applied; then
      omarchy-plymouth-reset || return 1
    fi
    remove_plymouth_theme
  fi
}

apply_piece() {
  case "$1" in
  wallpaper) apply_wallpaper ;;
  screensaver) apply_screensaver ;;
  lock) apply_lock ;;
  boot) apply_boot ;;
  widget) apply_widget ;;
  esac
}

# --- hooks ------------------------------------------------------------------
# What install.sh generates into ~/.config/omarchy/hooks/*.d/<slug> is a
# four-line wrapper calling back here, so the logic lives in one place and the
# generated file carries no provider names at all.

# Picking our theme returns the pack; picking any other stands it down, keeping
# the settings. Also the net that catches `omarchy refresh shell`.
cmd_hook_theme_set() {
  if [[ ${1:-} == "$SLUG" ]]; then
    cmd_doctor >/dev/null 2>&1 || true
  else
    cmd_suspend >/dev/null 2>&1 || true
  fi
}

# After `omarchy update`: the lock and the boot splash are derived from
# Omarchy's sources, so derive them again from the fresh ones.
cmd_hook_post_update() {
  # doctor's staleness check refreshes the pack's copies first, and re-asserts
  # the plugin AND re-derives the lock when that piece is on -- so there is no
  # second `lock on` here: against the same updated source the same patch fails
  # the same way, and the only thing a retry added was the work.
  cmd_doctor >/dev/null 2>&1 || true

  # The boot splash needs sudo, and there is a terminal here.
  if is_active boot; then
    apply_boot || echo "$DISPLAY_NAME: could not re-derive the boot splash" >&2
  fi

  # doctor's failure mode, when nobody watches stdout: the patch no longer fits
  # the updated LockView.qml. Say so -- but only when the piece is wanted and
  # the pack is in effect.
  local state
  state=$(cmd_status --json) || return 0
  [[ $(jq -r '.active and .settings.lock' <<<"$state") == "true" ]] || return 0
  [[ $(jq -r '.pieces.lock' <<<"$state") == "true" ]] && return 0

  omarchy-notification-send -g 󱄄 "$DISPLAY_NAME" \
    "Omarchy's lock has changed and the rain patch no longer fits. Native lock for now." \
    2>/dev/null || true
}

# --- commands ---------------------------------------------------------------

cmd_status() {
  local format="text" query="" piece
  while (($# > 0)); do
    case "$1" in
    --json) format="json"; shift ;;
    --is) query="${2:-}"; shift 2 ;;
    *) fail "unknown option: $1" ;;
    esac
  done

  if [[ -n $query ]]; then
    [[ " ${PIECES[*]} " == *" $query "* ]] || fail "unknown piece: $query"
    # What answers the menu's ✓: on AND in effect, not merely on.
    is_active "$query"
    return
  fi

  if [[ $format == "json" ]]; then
    # `settings` is what you asked for, `active` is what is happening. They are
    # not the same question -- see is_active -- and the widget draws its ticks
    # from `active` so that one definition serves both it and the text below.
    # `schema` versions this document: readers take 1 and reject anything else.
    jq -n \
      --argjson schema 1 \
      --argjson w "$(read_setting wallpaper)" --argjson s "$(read_setting screensaver)" \
      --argjson l "$(read_setting lock)" --argjson b "$(read_setting boot)" \
      --argjson aw "$(active_of wallpaper)" --argjson as "$(active_of screensaver)" \
      --argjson al "$(active_of lock)" --argjson ab "$(active_of boot)" \
      --argjson g "$(read_setting widget)" --argjson ag "$(active_of widget)" \
      --argjson effect "$(pack_in_effect && echo true || echo false)" \
      --arg theme "$(current_theme)" --arg name "$DISPLAY_NAME" --arg slug "$SLUG" \
      --arg version "$(pack_version)" \
      '{schema: $schema, name: $name, version: $version, slug: $slug, theme: $theme, active: $effect,
        settings: {wallpaper: $w, screensaver: $s, lock: $l, boot: $b, widget: $g},
        pieces: {wallpaper: $aw, screensaver: $as, lock: $al, boot: $ab, widget: $ag}}'
    return
  fi

  if ! pack_in_effect; then
    printf '  the pack is stood down: the current theme is \033[1m%s\033[0m, not %s\n' \
      "$(current_theme)" "$SLUG"
    printf '  bring it back with: omarchy theme set %s\n' "$SLUG"
    # Stood down should mean nothing enabled. Older versions of doctor got here
    # with the pieces still up; say so instead of looking clean.
    if plugin_enabled "$PLUGIN_ID" || plugin_enabled "$WIDGET_ID" || lock_clone_id >/dev/null 2>&1; then
      printf '  \033[2mbut pieces of it are still up -- stand them down with: %s doctor\033[0m\n' "$SELF"
    fi
    echo
  fi

  for piece in "${PIECES[@]}"; do
    if is_active "$piece"; then
      printf '  \033[32m✓\033[0m %-12s\n' "$piece"
    elif [[ $(read_setting "$piece") != "true" ]]; then
      printf '    %-12s\n' "$piece"
    elif [[ $piece == "boot" ]]; then
      printf '    %-12s \033[2mon, but not applied — run: %s boot on\033[0m\n' "$piece" "$SELF"
    elif ! pack_in_effect; then
      printf '    %-12s \033[2mon, but stood down with the theme\033[0m\n' "$piece"
    elif [[ $piece == "wallpaper" ]] && ! on_live_background; then
      # The one case that is neither: the theme is ours, the piece is on, and the
      # desktop is showing another background from the carousel. Asked
      # explicitly, so that a piece held back by anything else still says so
      # below rather than blaming the background.
      printf '    %-12s \033[2mon, but the desktop is on another background — run: %s wallpaper on\033[0m\n' \
        "$piece" "$SELF"
    else
      printf '    %-12s \033[2mon, but not in effect — run: %s doctor\033[0m\n' "$piece" "$SELF"
    fi
  done

  # Only when something actually wants it. With both rain layers off the plugin
  # is disabled on purpose, and telling the user to repair a machine that is
  # doing exactly what they asked is how a warning stops being read.
  if pack_in_effect && [[ $(read_setting wallpaper) == "true" || $(read_setting screensaver) == "true" ]] &&
    ! plugin_enabled "$PLUGIN_ID"; then
    printf '\n  the %s plugin is not active — fix it with: %s doctor\n' "$PLUGIN_ID" "$SELF"
  fi
}

cmd_doctor() {
  # Asserts everything again. This is what to run after an
  # `omarchy refresh shell`, which rewrites shell.json and leaves the plugin off.
  local failures=0
  echo "Checking the pack..."
  sync_files
  # Under ANOTHER theme there is nothing to assert: the pack is stood down by
  # design, and standing it up is exactly the bug this guards. install.sh ends
  # in doctor, so any `git pull && ./install.sh` run while on somebody else's
  # theme used to re-enable the plugin, the widget and the lock clone underneath
  # it -- observed: suspended correctly at 14:52 when the theme changed, stood
  # back up by a manual install that evening, raining under everforest.
  #
  # And if pieces are found UP while stood down -- a state only older versions
  # of this command could produce -- doctor's job is to stand them down.
  if ! pack_in_effect; then
    if plugin_enabled "$PLUGIN_ID" || plugin_enabled "$WIDGET_ID" || lock_clone_id >/dev/null 2>&1; then
      echo "  the theme is $(current_theme), but pieces of the pack are still up; standing them down"
      cmd_suspend
    else
      echo "  stood down: the current theme is $(current_theme), not $SLUG"
      echo "  nothing to repair; it all comes back with: omarchy theme set $SLUG"
    fi
    cmd_status
    return 0
  fi
  sync_screensaver
  sync_plugin || failures=1
  # The background too, when the piece is on. This is the other half of the ✓
  # that lied: `omarchy theme set` rotates to the next background, so coming
  # back to this theme lands on a still and the rain the user asked for is gone.
  # It only ever fights the rotation for somebody who explicitly asked for the
  # rain, which the settings already record -- and the carousel (`bg next`, the
  # picker) never calls a hook, so a deliberate pick inside the theme still
  # stands until the next `theme set`.
  [[ $(read_setting wallpaper) != "true" ]] || select_live_background
  apply_widget || failures=1
  [[ $(read_setting lock) != "true" ]] || apply_lock || failures=1
  nudge_shell
  # `boot` is left out on purpose: it needs sudo and this runs from hooks.
  cmd_status
  return $failures
}

# When the current theme stops being ours, the pack stands down without touching
# the settings: coming back restores exactly what you had.
#
# The lock stands down by deleting the clone, not by disabling it: see
# remove_lock_clone. `boot` is left alone, since the Plymouth splash belongs to
# the system rather than to the theme.
cmd_suspend() {
  # Remember what you left for. Omarchy overwrites current/theme.name before it
  # calls the theme-set hook, so this is the last moment anyone knows -- and
  # `uninstall.sh` needs it much later, to put you back where you were instead
  # of on whichever stock theme happens to sort first.
  local leaving
  leaving=$(current_theme)
  [[ -z $leaving || $leaving == "$SLUG" ]] || write_string previousTheme "$leaving"

  ! plugin_enabled "$PLUGIN_ID" || omarchy-plugin-disable "$PLUGIN_ID" >/dev/null
  forget_plugin_list
  # The bar icon goes with the rest: a Matrix switch on the bar under somebody
  # else's theme is the pack refusing to stand down (Rule 5).
  ! plugin_enabled "$WIDGET_ID" || omarchy-plugin-disable "$WIDGET_ID" >/dev/null
  forget_plugin_list
  omarchy-toggle screensaver-off off
  if lock_clone_id >/dev/null; then
    remove_lock_clone
    # Standing down runs from the theme-set hook, where nobody is watching the
    # output -- which is exactly when being left without a lock, or left with
    # the wrong one still painting, would go unnoticed.
    restart_shell_for_lock
    wait_for_lock
  fi
}

cmd_all() {
  local value="$1" piece
  for piece in wallpaper screensaver lock; do
    write_setting "$piece" "$value"
  done
  # Under another theme the settings are the whole command: the pieces apply
  # when the theme comes back (theme-set hook -> doctor). See cmd_doctor.
  if pack_in_effect; then
    # Wallpaper first, and actually APPLIED: writing the setting without this
    # left `off` sitting on the live background's still frame, which reads
    # exactly like rain that has frozen -- the state apply_wallpaper exists to
    # leave.
    apply_wallpaper
    apply_screensaver
    apply_lock
  fi
  cmd_status
}

usage() {
  cat <<USAGE
Usage: $SELF <command>

  on | off                            Turn the pack on or off (wallpaper,
                                      screensaver and lock -- not boot, which
                                      needs sudo, and not the widget, which is
                                      how you reach these switches)
  wallpaper|screensaver|lock|boot|widget on|off|toggle
                                      One piece at a time
  status [--is <piece>] [--json]      What is on
  doctor                              Assert everything again
  update [--check [--json]]           Pull the latest version of this theme,
                                      then doctor. --check only looks
  suspend                             Stand the pack down, keeping your settings
  uninstall [--keep-theme]            Remove the pack (execs uninstall.sh)

Pieces:
  wallpaper    Rain on the desktop (selects the live background)
  screensaver  Rain when you go idle, instead of Omarchy's terminal one
  lock         Rain behind the password field when you lock
  boot         The screen before login (Plymouth). Needs sudo.
  widget       The switchboard on the bar: these switches, one click away
USAGE
}

command="${1:-status}"
shift || true

case "$command" in
on) cmd_all true ;;
off) cmd_all false ;;
status) cmd_status "$@" ;;
doctor) cmd_doctor ;;
update) cmd_update "$@" ;;
suspend) cmd_suspend ;;
uninstall) exec "$ROOT/uninstall.sh" "$@" ;;
hook)
  # What the generated hooks call back into. Not for hands: no output, no
  # questions, failures swallowed the way a hook expects.
  event="${1:-}"; shift || true
  case "$event" in
  theme-set) cmd_hook_theme_set "$@" ;;
  post-update) cmd_hook_post_update "$@" ;;
  *) fail "unknown hook: $event" ;;
  esac
  ;;
wallpaper | screensaver | lock | boot | widget)
  action="${1:-toggle}"
  case "$action" in
  on) write_setting "$command" true ;;
  off) write_setting "$command" false ;;
  toggle) [[ $(read_setting "$command") == "true" ]] && write_setting "$command" false || write_setting "$command" true ;;
  *) fail "unknown action: $action (use on, off or toggle)" ;;
  esac
  # The theme-bound pieces only APPLY while their theme is current. Under
  # another one, writing the setting is the whole command -- the piece comes up
  # with the theme -- and applying anyway is how a hand run once stood the pack
  # up under somebody else's (see cmd_doctor). `boot` is the exception: the
  # splash belongs to the system, whichever theme is on.
  if [[ $command == "boot" ]] || pack_in_effect; then
    apply_piece "$command"
  else
    echo "$SELF: noted -- $command applies when the $SLUG theme is current"
  fi
  ;;
-h | --help | help) usage ;;
*) usage; exit 1 ;;
esac
