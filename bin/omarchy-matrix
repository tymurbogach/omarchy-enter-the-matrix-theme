#!/bin/bash

# The pack's command. There is nothing to switch: Omarchy's own menus decide.
#
#   <cli> status
#   <cli> doctor
#   <cli> update [--check]
#   <cli> boot on|off
#   <cli> uninstall [--keep-theme]
#
# While this theme is current, the rain covers the desktop when the rain is the
# background (Style > Background), covers Omarchy's screensaver whenever
# Omarchy opens it, and sits behind the lock. The boot splash follows
# Style > Unlock. Another theme stands the pack down.
#
# Which pack this is comes from provider.json, below: everything in here is
# machinery, and the provider contributes the shader, its assets and its names.

set -euo pipefail

SELF=$(basename "$0")

fail() {
  echo "$SELF: $*" >&2
  exit 1
}

# --- the provider -----------------------------------------------------------
# The pack is machinery plus one provider, and provider.json is the only file
# that names the provider. lib/provider.py resolves it the same way for the two
# derivers: keep the two in step.
#
# The CLI finds its own root by resolving itself: installed, it is a symlink
# into the share dir's bin/, and in a working copy it sits in the repo's bin/.
# Either way the root beside bin/ holds provider.json and lib/. The share dir
# outlives theme switches, which is exactly when `suspend` runs. An explicit
# $OMARCHY_MATRIX_PROVIDER still wins, and is what tests use.
ROOT=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
for candidate in \
  "${OMARCHY_MATRIX_PROVIDER:-}" \
  "$ROOT/provider.json"; do
  [[ -n $candidate && -f $candidate ]] || continue
  PROVIDER="$candidate"
  break
done
[[ -n ${PROVIDER:-} ]] || fail "cannot find provider.json. Re-run the pack's install.sh."

# Shared shell: provider names, paths, ownership, plugin list, settle, restart.
# shellcheck source=../lib/pack.sh
. "$ROOT/lib/pack.sh" || fail "cannot load $ROOT/lib/pack.sh"
pack_load_provider "$PROVIDER" || fail "$PROVIDER is not valid JSON"
pack_set_paths

# --- state ------------------------------------------------------------------

# The desktop pieces are only IN EFFECT while the pack's theme is the current
# one: picking another theme makes the theme-set hook call `suspend`. The boot
# splash is the exception, because Plymouth belongs to the system and not to
# the theme.
current_theme() {
  cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null
}

pack_in_effect() {
  [[ $(current_theme) == "$SLUG" ]]
}

# Is our Plymouth theme the one in use? Not `omarchy plymouth current`: that one
# identifies a theme by comparing logo.png inside Omarchy's OWN theme folder,
# and ours is a separate theme that it cannot see. `plymouth-set-default-theme`
# with no arguments prints the real answer and needs no sudo.
boot_applied() {
  local current
  current=$(plymouth-set-default-theme 2>/dev/null) ||
    current=$(sed -n 's/^Theme=//p' /etc/plymouth/plymouthd.conf 2>/dev/null)
  [[ $current == "$PLYMOUTH_THEME" ]]
}

# Omarchy's own still splash carries this theme when its logo is the theme's
# unlock.png. That is how `omarchy plymouth current` knows a theme.
omarchy_boot_is_ours() {
  [[ $(omarchy-plymouth-current 2>/dev/null) == "$SLUG" ]]
}

# A lock is ours AND actually in charge. Merely having the clone on disk is not
# it: `omarchy refresh shell` rewrites shell.json wholesale and leaves the folder
# sitting there with Omarchy's own lock enabled again.
lock_clone_enabled() {
  local id
  id=$(lock_clone_id) || return 1
  plugin_enabled "$id"
}

# Omarchy's own screensaver switch: `omarchy toggle screensaver` sets this flag.
# With it set, Omarchy opens no screensaver, so the rain has nothing to cover.
screensaver_flag_set() {
  [[ -f "$HOME/.local/state/omarchy/toggles/screensaver-off" ]]
}

on_live_background() {
  [[ $(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null) == *-live-* ]]
}

nudge_shell() {
  omarchy-shell "$IPC" refresh >/dev/null 2>&1 || true
}

# --- the theme directory ----------------------------------------------------
#
# `omarchy theme update` is a bare `git pull` per theme and fires NO hooks --
# not one, and `omarchy update` never calls it. So after a pull the theme moves
# on while the pack's copies of the plugin, the CLI, the derivers and the hooks
# sit at whatever version installed them. Nothing else would ever notice.
#
# So the CLI notices, on the one run that is meant to assert everything again:
# `doctor`, which the theme-set hook calls on every `omarchy theme set <slug>`.

theme_dir() {
  omarchy-theme-dir "$SLUG" 2>/dev/null
}

# Every file install.sh copies out of the theme directory, paired with where it
# lands. Kept here rather than derived from install.sh because a comparison that
# silently checks nothing is worse than no comparison at all.
installed_pairs() {
  local theme="$1" f
  for f in $(jq -r '.plugin.files[]' "$PROVIDER"); do
    echo "$theme/$PLUGIN_SRC/$f|$PLUGINS_DIR/$PLUGIN_ID/$f"
  done
  echo "$theme/bin/$CLI|$SHARE_DIR/bin/$CLI"
  echo "$theme/lib/derive-lock.py|$SHARE_DIR/lib/derive-lock.py"
  echo "$theme/lib/derive-plymouth.py|$SHARE_DIR/lib/derive-plymouth.py"
  echo "$theme/lib/derive-menu.py|$SHARE_DIR/lib/derive-menu.py"
  echo "$theme/lib/provider.py|$SHARE_DIR/lib/provider.py"
  echo "$theme/lib/pack.sh|$SHARE_DIR/lib/pack.sh"
  echo "$theme/uninstall.sh|$SHARE_DIR/uninstall.sh"
  # The hooks are deliberately ABSENT: install.sh generates their wrappers on
  # every run (including the --sync this function ends up calling), so there
  # is no theme source to compare and nothing to go stale.
  echo "$theme/provider.json|$SHARE_DIR/provider.json"
}

# NEWER, not merely different. "Different" is the wrong question and it bit on
# the first run: a working copy installed over an older theme directory looks
# exactly as different as a pulled theme looks over an older install, and
# syncing then copies the OLD files over the new ones. A `git pull` gives every
# file it changes a fresh mtime, which is precisely the event this is for.
#
# A source file that is missing is not staleness either, it is a theme directory
# that does not carry that file -- an older or a newer layout.
files_outdated() {
  local theme="$1" source target top
  while IFS='|' read -r source target; do
    [[ -f $source ]] || continue
    # A plugin folder carrying a .git checkout is managed by hand, and
    # install.sh leaves it alone for the same reason: judging it stale here
    # would send --sync after a checkout nothing may overwrite.
    case "$target" in
    "$PLUGINS_DIR"/*)
      top="${target#"$PLUGINS_DIR"/}"; top="${top%%/*}"
      [[ -e $PLUGINS_DIR/$top/.git ]] && continue
      ;;
    esac
    [[ -f $target && ! $source -nt $target ]] || return 0
  done < <(installed_pairs "$theme")
  return 1
}

sync_files() {
  local theme
  theme=$(theme_dir) || return 0
  [[ -n $theme && -x $theme/install.sh ]] || return 0
  files_outdated "$theme" || return 0
  echo "  the theme directory has moved on; refreshing the pack's copies"
  "$theme/install.sh" --sync || echo "  could not refresh them; run $theme/install.sh" >&2
}

# --- updates ----------------------------------------------------------------
#
# The theme updates from its own repository and from nowhere else, and only
# when you ask: `update --check` looks, `update` pulls.
#
# The URL is written out in the two git commands below, not read from
# provider.json like every other name in this file. The marketplace's security
# baseline accepts a pull whose result later runs only when the command itself
# names the submission's own repository (commandUsesOnlySubmissionRepository in
# its scripts/security-baseline-analysis.mjs). Behind a variable it sees no URL
# and reports unpinned remote code. tools/check.sh keeps both URLs equal to
# provider.json's repoUrl.
#
# `omarchy theme update` is not used: it pulls every git theme you have, not
# only this one.

# The version of the theme folder. doctor syncs the pack to it on the next
# `omarchy theme set`, so this is the version you run.
pack_version() {
  local dir
  dir=$(theme_dir) || return 0
  jq -r '.version // ""' "$dir/manifest.json" 2>/dev/null || true
}

# Never fails. No network, a theme folder that is not a git clone, or a clone
# with commits of its own all mean "no update to offer": a clone that has moved
# on by itself is somebody's working copy, and pulling into it is their call.
cmd_update_check() {
  local dir current latest
  dir=$(theme_dir) || dir=""
  current=$(pack_version)
  if [[ -z $dir || ! -e $dir/.git ]] ||
    ! timeout 15 git -C "$dir" fetch --quiet https://github.com/tymurbogach/omarchy-enter-the-matrix-theme master 2>/dev/null; then
    echo "$DISPLAY_NAME ${current:-?}: could not check for updates (no network, or the theme folder is not a git clone)"
    return 0
  fi
  if ! git -C "$dir" merge-base --is-ancestor FETCH_HEAD HEAD 2>/dev/null &&
    git -C "$dir" merge-base --is-ancestor HEAD FETCH_HEAD 2>/dev/null; then
    latest=$(git -C "$dir" show FETCH_HEAD:manifest.json 2>/dev/null | jq -r '.version // ""') || latest=""
    echo "$DISPLAY_NAME ${latest:-a newer version} is out, and you have ${current:-an older version}. Update with: $SELF update"
  else
    echo "$DISPLAY_NAME ${current:-?} is the latest version"
  fi
}

cmd_update() {
  case "${1:-}" in
  --check) cmd_update_check; return ;;
  "") ;;
  *) fail "unknown option: $1 (use: update, or update --check)" ;;
  esac
  local dir
  dir=$(theme_dir) || dir=""
  [[ -n $dir && -e $dir/.git ]] ||
    fail "the theme folder ${dir:-for $SLUG} is not a git clone, so it cannot update itself. Install it again with: omarchy theme install $(jq -r .repoUrl "$PROVIDER")"
  echo "Updating $DISPLAY_NAME in $dir"
  git -C "$dir" pull --ff-only https://github.com/tymurbogach/omarchy-enter-the-matrix-theme master ||
    fail "the pull stopped. If you changed files in $dir, commit or discard them, then run this again."
  # The pulled theme's own CLI runs doctor: a new doctor applies a new layout,
  # and nothing overwrites this script while bash is still reading it.
  exec "$dir/bin/$CLI" doctor
}

# --- one restart ------------------------------------------------------------
#
# Two things need a shell restart, and a rescan fixes neither:
#
# - A swap of the lock plugin leaves BOTH locks loaded. Quickshell then hands
#   the `lock` IPC target to one of them and refuses the other ("another
#   handler is registered for target lock"). Which one wins is not ours to
#   choose: when Omarchy's won, the machine locked to its blurred wallpaper
#   while every check of the pack passed.
# - A hot reload of plugin QML can leave two instances alive, the old one still
#   answering IPC.
#
# A restart blanks the bar and the background for a moment. Each one used to
# come with its own step, so an install flickered several times. Now a command
# compares pack_fingerprint (lib/pack.sh) before and after its work, and
# restarts once at the end, and only if the shell has something to unload.
# install.sh sets OMARCHY_MATRIX_RESTART=1 when it replaced the live plugin
# before this command started.
#
# A rescan still in flight when the shell goes down segfaults quickshell
# (quickshell-mirror/quickshell#972). restart_shell lets the scan settle first.

FINGERPRINT=""

begin_changes() {
  FINGERPRINT=$(pack_fingerprint)
}

finish_changes() {
  if [[ $(pack_fingerprint) == "$FINGERPRINT" && ${OMARCHY_MATRIX_RESTART:-0} != 1 ]]; then
    return 0
  fi
  restart_shell || {
    echo "$SELF: the shell did not restart. Run 'omarchy restart shell' before you lock the screen." >&2
    return 1
  }
  wait_for_lock
}

# Waits for a STEADY answer, not for the first one. Measured here: `lock off`
# returns after ~0.8s, while the handler on its way out is still registered and
# still replying; the real gap does not open until ~1.3s and lasts ~0.6s. A
# guard that stops at the first success is answered by the plugin that is
# leaving, and reports everything fine a second before nothing answers at all.
#
# So: 1.8s of uninterrupted replies, and any silence resets the count.
wait_for_lock() {
  local steady=0 waited=0
  while ((waited < 100)); do # 15s ceiling
    if omarchy-shell lock status 2>/dev/null | jq -e '.passwordPam' >/dev/null 2>&1; then
      steady=$((steady + 1))
      ((steady < 12)) || return 0
    else
      steady=0
    fi
    sleep 0.15
    waited=$((waited + 1))
  done
  echo "$SELF: the lock is not answering steadily after the restart." >&2
  echo "  Run 'omarchy restart shell' before locking the screen." >&2
  return 1
}

# --- the pieces -------------------------------------------------------------

# One plugin draws the rain on the desktop and over the screensaver. It decides
# nothing: the background says whether the desktop rains, and Omarchy says when
# its screensaver opens.
sync_plugin() {
  if ! plugin_known "$PLUGIN_ID"; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    sleep 0.3
    forget_plugin_list
  fi
  plugin_known "$PLUGIN_ID" || {
    echo "$SELF: the $PLUGIN_ID plugin is not installed" >&2
    # NOT `omarchy plugin add <repo-url>`: that would install the whole repo as
    # the plugin, and skip the CLI and the hooks. install.sh copies in the few
    # files the plugin needs. It is the only supported path.
    echo "  install it with: $(theme_dir || echo "$HOME/.config/omarchy/themes/$SLUG")/install.sh" >&2
    return 1
  }
  plugin_enabled "$PLUGIN_ID" || { omarchy-plugin-enable "$PLUGIN_ID" >/dev/null; forget_plugin_list; }
}

# The rain behind the password field. A WlSessionLock is exclusive, so this is
# the one piece that stands in for a plugin of Omarchy's. The deriver resolves
# provider.json on its own, and could find a different one than this CLI did (a
# working copy beside an install). Hand it ours.
apply_lock() {
  OMARCHY_MATRIX_PROVIDER="$PROVIDER" "$ROOT/lib/derive-lock.py" >/dev/null
}

# Handing Omarchy's lock back ALWAYS goes through `plugin remove`, which is what
# re-enables it (cloneSourceRestores). Merely disabling the clone would leave
# the session with no lock enabled at all, because cloning put Omarchy's own
# into disabledPlugins: the machine could not lock.
remove_lock_clone() {
  local id
  id=$(lock_clone_id) || return 0
  remove_plugin "$id"
  forget_plugin_list
  prune_backups
}

# Another theme stands everything down: nothing rains, and nothing of the pack
# stays enabled. Nothing of Omarchy's stays disabled either.
stand_down() {
  ! plugin_enabled "$PLUGIN_ID" || omarchy-plugin-disable "$PLUGIN_ID" >/dev/null
  forget_plugin_list
  remove_lock_clone
}

# The screen before login. Needs sudo and rebuilds the initramfs, so it never
# happens on its own: only on a first install that took the red pill, from
# Omarchy's Style > Unlock (lib/derive-menu.py), or by hand.
#
# derive-plymouth.py adds the animation as a theme of its own beside Omarchy's,
# and makes it the default: one rebuild, like any other card in Unlock.
# Omarchy's still splash is not installed underneath. That took a second
# rebuild, only so that Unlock would mark this card.
derive_boot() {
  OMARCHY_MATRIX_PROVIDER="$PROVIDER" "$ROOT/lib/derive-plymouth.py"
}

# Only reset when a Matrix splash is the one installed: the animation, or
# Omarchy's still one. Resetting unconditionally rebuilt the initramfs for
# nothing, and dragged somebody who had picked `spinner` back to Omarchy's,
# overriding a choice the pack never made. The directory goes either way.
boot_off() {
  if boot_applied || omarchy_boot_is_ours; then
    omarchy-plymouth-reset || return 1
  fi
  remove_plymouth_theme
}

# The pack's only footprint outside $HOME. `omarchy plymouth reset` puts
# Omarchy's theme back but leaves ours in /usr/share/plymouth/themes, so off
# takes it back too. Always AFTER the reset, never before: pulling the folder
# out from under a theme that is still the default boots to a black screen.
# The text face in /usr/share/fonts goes with it: it arrived with the splash,
# and only the splash needs it there.
remove_plymouth_theme() {
  local dir="/usr/share/plymouth/themes/$PLYMOUTH_THEME"
  [[ -d $dir ]] && sudo rm -rf "$dir"
  if [[ -d /usr/share/fonts/omarchy-matrix ]]; then
    sudo rm -rf /usr/share/fonts/omarchy-matrix
    sudo fc-cache -f >/dev/null 2>&1 || true
  fi
}

# Two rows of Omarchy's menu (lib/derive-menu.py): in Style > Unlock the card of
# this theme boots animated, and Remove > Theme takes the pack with the theme.
# They follow the system and not the theme, so they stay while another theme
# is current.
apply_unlock_menu() {
  OMARCHY_MATRIX_PROVIDER="$PROVIDER" "$ROOT/lib/derive-menu.py"
}

# --- hooks ------------------------------------------------------------------
# What install.sh generates into ~/.config/omarchy/hooks/*.d/<slug> is a
# four-line wrapper calling back here, so the logic lives in one place and the
# generated file carries no provider names at all.

# Picking our theme brings the pack up; picking any other stands it down. Also
# the net that catches `omarchy refresh shell`, and a theme removed from a
# terminal (cmd_hook_theme_remove).
cmd_hook_theme_set() {
  if theme_removed; then
    cmd_hook_theme_remove
  elif [[ ${1:-} == "$SLUG" ]]; then
    cmd_doctor >/dev/null 2>&1 || true
  else
    cmd_suspend >/dev/null 2>&1 || true
  fi
}

# Omarchy's Remove > Theme and `omarchy theme remove` delete the theme's folder
# and nothing else, and no hook runs after them. Without its theme the pack has
# nothing to serve, so it follows: it stands down at once, and the full
# uninstall opens in Omarchy's floating terminal. The terminal is there for
# the password that the boot splash needs.
#
# Remove > Theme calls this right after Omarchy's own command
# (lib/derive-menu.py). A removal from a terminal passes no menu, so the
# theme-set hook calls it at the next theme change.
theme_removed() {
  [[ ! -d $HOME/.config/omarchy/themes/$SLUG && ! -d ${OMARCHY_PATH:-/usr/share/omarchy}/themes/$SLUG ]]
}

cmd_hook_theme_remove() {
  theme_removed || return 0
  cmd_suspend >/dev/null 2>&1 || true
  omarchy-launch-floating-terminal-with-presentation "'$BIN_DIR/$CLI' uninstall" >/dev/null 2>&1 &
}

# After `omarchy update`: the lock, the boot splash and the Unlock row come from
# Omarchy's sources, so derive them again from the fresh ones.
cmd_hook_post_update() {
  cmd_doctor >/dev/null 2>&1 || true

  # The boot splash needs sudo, and there is a terminal here.
  if boot_applied; then
    derive_boot || echo "$DISPLAY_NAME: could not derive the boot splash again" >&2
  fi

  # doctor derived the menu rows again. If one of Omarchy's rows changed shape,
  # the deriver handed that row back to Omarchy. Say so: nobody reads doctor
  # here.
  if ! apply_unlock_menu >/dev/null 2>&1; then
    omarchy-notification-send -g 󰟵 "$DISPLAY_NAME" \
      "Omarchy's menu has changed, so Style › Unlock or Remove › Theme is Omarchy's own for now." \
      2>/dev/null || true
  fi

  # doctor's failure mode, when nobody watches stdout: the patch no longer fits
  # the updated LockView.qml, and Omarchy's own lock stays in charge.
  forget_plugin_list
  if pack_in_effect && ! lock_clone_enabled; then
    omarchy-notification-send -g 󱄄 "$DISPLAY_NAME" \
      "Omarchy's lock has changed and the rain patch no longer fits. Native lock for now." \
      2>/dev/null || true
  fi
}

# --- commands ---------------------------------------------------------------

status_row() { # <on|off> <piece> <text>
  if [[ $1 == on ]]; then
    printf '  \033[32m✓\033[0m %-12s %s\n' "$2" "$3"
  else
    printf '    %-12s \033[2m%s\033[0m\n' "$2" "$3"
  fi
}

# A ✓ means "this is happening now", never "this is configured": each row asks
# the machinery. After `omarchy refresh shell` wiped shell.json, a status that
# read settings ticked a lock that Omarchy's own lock had replaced.
cmd_status() {
  # Up to 1.2.x, `status --is <piece>` answered yes or no, and scripts of the
  # user's own may still ask it. An option ignored here would answer yes to
  # every question, so any option fails.
  (($# == 0)) || fail "status takes no options (the pieces have no switches since 1.3)"
  local version
  version=$(pack_version)
  printf '  %s%s\n\n' "$DISPLAY_NAME" "${version:+ $version}"

  if theme_removed; then
    printf '  The %s theme is gone. Remove the rest of the pack: %s uninstall\n\n' \
      "$DISPLAY_NAME" "$SELF"
  fi

  if ! pack_in_effect; then
    printf '  Stood down: the theme is %s. Back with Style › Theme › %s.\n' \
      "$(current_theme)" "$DISPLAY_NAME"
    # Stood down should mean nothing enabled. Say so instead of looking clean.
    if plugin_enabled "$PLUGIN_ID" || lock_clone_id >/dev/null; then
      printf '  \033[2mBut pieces of it are still up. Stand them down with: %s doctor\033[0m\n' "$SELF"
    fi
    echo
  else
    if ! plugin_enabled "$PLUGIN_ID"; then
      status_row off desktop "the rain plugin is off. Repair: $SELF doctor"
      status_row off screensaver "the rain plugin is off. Repair: $SELF doctor"
    else
      if on_live_background; then
        status_row on desktop "rain behind your windows"
      else
        status_row off desktop "another background. For the rain: Style › Background"
      fi
      # Not a fault: the user switched Omarchy's screensaver off, and the rain
      # only covers that one. doctor must not overrule the choice.
      if screensaver_flag_set; then
        status_row off screensaver "Omarchy's screensaver is off. On again: omarchy toggle screensaver"
      else
        status_row on screensaver "rain over Omarchy's screensaver"
      fi
    fi
    if lock_clone_enabled; then
      status_row on lock "rain behind the password field"
    else
      status_row off lock "Omarchy's own lock is in charge. Repair: $SELF doctor"
    fi
  fi

  if boot_applied; then
    status_row on boot "the lines from the film, before login"
  else
    status_row off boot "Omarchy's splash. For the Matrix one: Style › Unlock"
  fi
}

# Asserts everything again. This is what to run after an `omarchy refresh
# shell`, which rewrites shell.json and leaves the plugin off.
cmd_doctor() {
  local failures=0 theme
  begin_changes
  pack_migrate
  sync_files
  # The rain's background belongs to the theme's own list, so it is offered
  # whichever theme is current. Omarchy shows it only under this theme.
  theme=$(theme_dir) || theme=""
  [[ -z $theme ]] || offer_live_background "$theme"
  # Style > Unlock belongs to the boot splash, which follows the system and not
  # the theme, so it is derived again whichever theme is current.
  apply_unlock_menu >/dev/null || failures=1
  if pack_in_effect; then
    sync_plugin || failures=1
    apply_lock || failures=1
    nudge_shell
  else
    # Under ANOTHER theme there is nothing to put up, and putting it up is the
    # bug this guards: install.sh ends in doctor, and a manual `git pull &&
    # ./install.sh` once stood the pack up under everforest. A piece found up
    # here, from an older version or a crash, goes down.
    stand_down
  fi
  finish_changes || failures=1
  cmd_status
  return $failures
}

# When the current theme stops being ours, the pack stands down. The lock
# stands down by deleting the clone, not by disabling it: see remove_lock_clone.
# The boot splash stays, since it belongs to the system rather than to the theme.
cmd_suspend() {
  # Remember what you left for. Omarchy overwrites current/theme.name before it
  # calls the theme-set hook, so this is the last moment anyone knows -- and
  # `uninstall.sh` needs it much later, to put you back where you were instead
  # of on whichever stock theme happens to sort first.
  local leaving
  leaving=$(current_theme)
  [[ -z $leaving || $leaving == "$SLUG" ]] || remember_previous_theme "$leaving"
  begin_changes
  pack_migrate
  stand_down
  finish_changes
}

cmd_boot() {
  case "${1:-}" in
  on) derive_boot ;;
  off) boot_off ;;
  *) fail "use: $SELF boot on, or $SELF boot off" ;;
  esac
}

# Up to 1.2.x each piece had a switch. Say where each choice lives now, rather
# than "unknown command" to somebody who follows an older README.
no_switches() {
  cat >&2 <<EOF
$SELF: the pieces have no switches any more. Omarchy's own menus decide:
  desktop rain   Style › Background, the rain
  boot splash    Style › Unlock, the $DISPLAY_NAME card
The lock and the screensaver rain whenever the $DISPLAY_NAME theme is on.
EOF
  exit 1
}

usage() {
  cat <<USAGE
Usage: $SELF <command>

  status                      What the pack does right now
  doctor                      Put everything back, for example after
                              'omarchy refresh shell'
  update [--check]            Pull the latest version of this theme, then
                              doctor. --check only looks
  boot on|off                 The Matrix boot splash, as Style › Unlock sets
                              it. Needs sudo
  uninstall [--keep-theme]    Remove the pack, and the theme unless
                              --keep-theme

There is nothing to switch. While the $DISPLAY_NAME theme is on:
  desktop       rains when the rain is the background (Style › Background)
  screensaver   rains over Omarchy's screensaver, whenever Omarchy opens it
  lock          rains behind the password field
  boot          types the lines from the film, when Style › Unlock picks it
USAGE
}

command="${1:-status}"
shift || true

case "$command" in
status) cmd_status "$@" ;;
doctor) cmd_doctor ;;
update) cmd_update "$@" ;;
boot) cmd_boot "$@" ;;
suspend) cmd_suspend ;;
uninstall) exec "$ROOT/uninstall.sh" "$@" ;;
hook)
  # What the generated hooks call back into. Not for hands: no output, no
  # questions, failures swallowed the way a hook expects.
  event="${1:-}"; shift || true
  case "$event" in
  theme-set) cmd_hook_theme_set "$@" ;;
  theme-remove) cmd_hook_theme_remove ;;
  post-update) cmd_hook_post_update "$@" ;;
  *) fail "unknown hook: $event" ;;
  esac
  ;;
on | off | wallpaper | screensaver | lock | widget) no_switches ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
